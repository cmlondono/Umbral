[Unit]
Description=Umbral, panel de control del servidor y la red de casa
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=umbral
Group=umbral
SupplementaryGroups=docker
ExecStart=/usr/local/bin/umbral serve -datos /var/lib/umbral
Restart=on-failure
RestartSec=5

# Límites: el panel gasta unos 15 MB; nunca podrá pasar de 128 MB.
MemoryMax=128M
CPUQuota=50%
Nice=5

# Endurecimiento: sin privilegios, sistema de archivos de solo lectura salvo
# sus carpetas de datos y, para copiar las copias de seguridad a un disco
# externo, /media y /mnt (solo donde el usuario umbral tenga permiso).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/umbral /srv/umbral -/media -/mnt
StateDirectory=umbral
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
